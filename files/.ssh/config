AddKeysToAgent yes
HashKnownHosts no
UserKnownHostsFile  ~/.ssh/known_hosts
Host *.prod.homelab.peterkuehne.com
  User peter
  CanonicalDomains prod.homelab.peterkuehne.com
  CanonicalizeHostname yes
  CanonicalizeMaxDots 1
  GSSAPIAuthentication yes
  GSSAPIDelegateCredentials yes
  PasswordAuthentication no
  PreferredAuthentications gssapi-with-mic,publickey
  PubkeyAuthentication yes
  VerifyHostKeyDNS ask
Host git.homelab.peterkuehne.com git.homelab.peterkuehne.com.
  User git
  CanonicalizeHostname no
  IdentityFile ~/.ssh/id_peter
  PasswordAuthentication no
  PubkeyAuthentication yes
Host github.com github.com.
  User git
  CanonicalizeHostname no
  IdentityFile ~/.ssh/id_peter
  PasswordAuthentication no
  PubkeyAuthentication yes

Host *
  ForwardAgent no
  AddKeysToAgent no
  Compression no
  ServerAliveInterval 0
  ServerAliveCountMax 3
  HashKnownHosts no
  UserKnownHostsFile ~/.ssh/known_hosts
  ControlMaster no
  ControlPath ~/.ssh/master-%r@%n:%p
  ControlPersist no

  

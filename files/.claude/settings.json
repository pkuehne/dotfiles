{
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "mcp__obsidian__*"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true
}
